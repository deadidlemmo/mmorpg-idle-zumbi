# API REST do backend.
VITE_API_URL=http://localhost:3000

# Base do Socket.IO. Se omitida, os clientes usam fallback para VITE_API_URL.
VITE_SOCKET_URL=http://localhost:3000

# Fallback legado usado por providers de gathering/crafting.
VITE_BACKEND_URL=http://localhost:3000

# Convite do Discord. Se omitido, a interface usa o convite público padrão.
VITE_DISCORD_URL=https://discord.gg/vPCB53mwN

# Timeline visual v2 do auto-combate. Use false apenas para rollback.
VITE_AUTO_COMBAT_PRESENTATION_TIMELINE_V2=true
VITE_AUTO_COMBAT_HUNT_TIMELINE_V1=admin

# HMR opcional do Vite para tunnel/proxy.
# VITE_HMR_PROTOCOL=ws
# VITE_HMR_CLIENT_PORT=5173
