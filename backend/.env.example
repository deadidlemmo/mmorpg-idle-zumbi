# PostgreSQL/Prisma.
# Docker Compose local deste repositorio:
# DATABASE_URL="postgresql://zumbi:zumbi123@localhost:5433/mmorpg_zumbi?schema=public"
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nome_do_banco?schema=public"

# JWT HTTP e WebSocket.
JWT_SECRET="troque_esta_chave"

# Presente no exemplo, mas o AuthModule atual usa expiresIn: '7d' fixo.
# Confirme o codigo antes de tratar esta variavel como funcional.
JWT_EXPIRES_IN="7d"

# URL publica e SMTP usados na recuperacao de conta.
FRONTEND_URL="http://localhost:5173"
# Lista separada por virgulas; em producao, somente origens explicitas sao aceitas.
CORS_ALLOWED_ORIGINS=""
# Quantidade de proxies reversos confiaveis ate a aplicacao. Use 0 sem proxy.
TRUST_PROXY_HOPS="0"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Dead Idle <no-reply@example.com>"
# Somente desenvolvimento: mostra o token na resposta e registra o link local.
PASSWORD_RESET_EXPOSE_TOKEN="false"

# Exclusivo para processos E2E com NODE_ENV=test. Nunca ative em ambiente compartilhado.
E2E_RATE_LIMIT_DISABLED="false"

# Observabilidade e alertas locais.
SLOW_REQUEST_THRESHOLD_MS="1500"
ALERT_MAX_ERRORS_5M="25"
ALERT_MAX_HEAP_MB="768"
ALERT_MAX_REQUEST_DURATION_MS="5000"
ALERT_COOLDOWN_SECONDS="300"
ALERT_WEBHOOK_URL=""
ALERT_WEBHOOK_TOKEN=""
ALERT_WEBHOOK_TIMEOUT_MS="5000"
# Obrigatorio em producao para consultar GET /metrics via Bearer token.
METRICS_TOKEN=""

# Registro local usado pelo painel/metricas para vigiar backup, copia externa e restore drill.
BACKUP_STATUS_PATH="backups/status.json"
BACKUP_MAX_AGE_HOURS="4"
BACKUP_VERIFICATION_MAX_AGE_HOURS="168"
BACKUP_OFFSITE_REQUIRED="true"
BACKUP_OFFSITE_MAX_AGE_HOURS="4"
BACKUP_R2_BUCKET="deadidle-backups"
# Diretorio que contem a instalacao local do Wrangler usada para enviar ao R2.
BACKUP_WRANGLER_CWD="../frontend"
# Opcional no Windows quando o PostgreSQL nao estiver no PATH.
POSTGRES_BIN_DIR="C:/Program Files/PostgreSQL/16/bin"

# Redis para coordenacao de workers e propagacao Socket.IO entre instancias.
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_TLS="false"
# REDIS_URL="redis://usuario:senha@host:6379"
REDIS_COORDINATION_ENABLED="false"
SOCKET_REDIS_ADAPTER_ENABLED="false"
# Em producao multi-instancia, use true para impedir fallback inseguro.
REDIS_REQUIRED="false"

# Libera World Boss sem travas de horário/nível apenas para QA local.
WORLD_BOSS_TEST_UNLOCK_ENABLED="false"

# Porta do NestJS. Plataformas como o Render injetam PORT automaticamente.
PORT=""
APP_PORT="3000"
